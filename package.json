{
  "name": "dotfiles",
  "private": true,
  "scripts": {
    "validate": "run-p validate:*",
    "validate:format": "prettier --check .",
    "validate:markdown": "markdownlint-cli2 --config node_modules/dev-config/src/markdownlint-cli2.jsonc \"**/*.md\"",
    "validate:package-json": "npmPkgJsonLint --configFile node_modules/dev-config/src/npmpackagejsonlintrc.json \"**/package.json\"",
    "validate:secrets": "secretlint --secretlintrc node_modules/dev-config/src/secretlintrc.json --secretlintignore node_modules/dev-config/src/secretlintignore \"**/*\"",
    "validate:spell": "cspell --no-progress \"**\"",
    "validate:text": "textlint --config node_modules/dev-config/src/textlintrc.json --ignore-path node_modules/dev-config/src/textlintignore \"**/*.md\""
  },
  "devDependencies": {
    "dev-config": "github:takudev-works/dev-config#v5.6.0"
  },
  "prettier": "dev-config/src/prettierrc.json"
}
